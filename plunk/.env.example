# Copy to plunk/.env and fill secrets. Do not commit .env.
# Homelab CraveCircle values (JWT, DB password, SES keys) stay on that
# machine in ~/plunk/.env. Generate new secrets for this Mac.

DB_PASSWORD=change-me
JWT_SECRET=change-me
MINIO_ROOT_USER=plunk
MINIO_ROOT_PASSWORD=change-me
S3_ACCESS_KEY_SECRET=change-me

# Host-header routing. Browsers resolve *.localhost to 127.0.0.1.
# Use these names, not app.cravecircle.cc (that is the Homelab tunnel).
API_DOMAIN=mail-api.localhost
DASHBOARD_DOMAIN=app.localhost
LANDING_DOMAIN=email.localhost
WIKI_DOMAIN=docs.localhost
USE_HTTPS=false

PLUNK_HTTP_PORT=8085
API_URI=http://mail-api.localhost:8085
DASHBOARD_URI=http://app.localhost:8085
LANDING_URI=http://email.localhost:8085
WIKI_URI=http://docs.localhost:8085

NTFY_PORT=8083
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY_ID=plunk
S3_BUCKET=uploads
S3_PUBLIC_URL=http://127.0.0.1:9000/uploads
S3_FORCE_PATH_STYLE=true
NTFY_URL=http://ntfy/plunk-notifications

# API process refuses to boot if these are empty. Placeholders are enough
# for the dashboard. Replace with real SES keys only when you need to send.
AWS_SES_REGION=ap-southeast-2
AWS_SES_ACCESS_KEY_ID=AKIADUMMYLOCALONLY
AWS_SES_SECRET_ACCESS_KEY=dummy-local-not-a-real-secret
SES_CONFIGURATION_SET=plunk-tracking
SES_CONFIGURATION_SET_NO_TRACKING=plunk-no-tracking

DISABLE_SIGNUPS=false
AUTO_PROJECT_DISABLE=false
